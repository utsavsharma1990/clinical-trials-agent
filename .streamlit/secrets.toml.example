# Streamlit Cloud secrets template.
# In Streamlit Cloud: App Settings → Secrets → paste the real values.
# Locally: copy to secrets.toml (also git-ignored) OR just use .env.

ANTHROPIC_API_KEY = "sk-ant-api03-...your-key-here..."
TAVILY_API_KEY    = "tvly-...your-key-here..."

# Optional
MAX_QUERIES_PER_SESSION = "20"
